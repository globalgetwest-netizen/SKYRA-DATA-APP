# ------------------------------------------------------------------------
# Skyra Data — Mobile client environment
# ------------------------------------------------------------------------
# Only EXPO_PUBLIC_* variables are readable by the Expo client bundle.
# NEVER put payment secret keys, telecom provider credentials, or webhook
# secrets here. Those belong ONLY on the Skyra Data backend.
# ------------------------------------------------------------------------

# App environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Use fully isolated mock providers instead of the real backend.
# true  -> mock networks / bundles / payment / fulfilment (dev only)
# false -> talk to the real Skyra Data backend at EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_USE_MOCK_DATA=true

# Base URL of the Skyra Data backend API (HTTPS required in production).
EXPO_PUBLIC_API_BASE_URL=https://api.skyradata.example.com

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Public (publishable) payment key ONLY. This is the client-side key the
# payment provider marks as safe to ship in a mobile app. It is NOT a secret.
# Leave blank when USE_MOCK_DATA=true.
EXPO_PUBLIC_PAYMENT_PUBLIC_KEY=

# Optional: support contact surfaced in the Help Centre.
EXPO_PUBLIC_SUPPORT_EMAIL=support@skyradata.example.com
EXPO_PUBLIC_SUPPORT_PHONE=+233000000000
